# Root reference only - the running apps read from apps/web/.env and
# apps/api/.env respectively (see those .env.example files). This file exists
# so every variable used anywhere in the project is documented in one place.
# Never put real secrets in any committed .env.example file.

# --- apps/web (frontend, Publishable key only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:4000/api

# --- apps/api (backend) ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# WARNING: full database access, bypasses RLS. Used ONLY by the
# seed:demo-users script, never read by the running server. Never expose to
# the frontend, never log it, never commit it.
SUPABASE_SECRET_KEY=

# --- apps/api seed:demo-users script only ---
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
DEMO_STUDENT1_EMAIL=
DEMO_STUDENT1_PASSWORD=
DEMO_STUDENT2_EMAIL=
DEMO_STUDENT2_PASSWORD=
