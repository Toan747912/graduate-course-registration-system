# Copy to apps/api/.env and fill in real values. Never commit apps/api/.env.

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Read by the running server (apps/api/src/config/env.ts). Every request is
# scoped to the caller's own JWT, so RLS stays in force - see
# apps/api/src/lib/supabaseClient.ts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# WARNING: full database access, bypasses RLS. Used ONLY by
# `npm run seed:demo-users` (apps/api/src/scripts/seedDemoUsers.ts) - the
# running server never reads this variable. Never expose it to the frontend,
# never log it, never commit it.
SUPABASE_SECRET_KEY=

# Used only by `npm run seed:demo-users` (apps/api/src/scripts/seedDemoUsers.ts).
# Local/demo credentials only - do not use real personal data or reuse passwords.
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
DEMO_STUDENT1_EMAIL=
DEMO_STUDENT1_PASSWORD=
DEMO_STUDENT2_EMAIL=
DEMO_STUDENT2_PASSWORD=
